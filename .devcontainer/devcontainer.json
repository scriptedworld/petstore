{
  "name": "PetStore Python",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "mounts": [
    "source=petstore-uv-cache,target=/home/vscode/.cache/uv,type=volume"
  ],
  "postCreateCommand": "uv sync --frozen && (git rev-parse --git-dir >/dev/null 2>&1 && uv run just hooks || true)",
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "ms-python.python"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.rulers": [150],
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "ruff.nativeServer": "on"
      }
    }
  }
}

